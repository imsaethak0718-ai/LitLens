# ==============================================================================
# LitLens Backend Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and replace placeholder values with your project credentials:
#   cp .env.example .env
#
# NEVER commit the active .env file or real credentials to source control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Allowed Frontend Origins (comma-separated if multiple)
# In development, points to the local Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for client-authenticated requests via user JWTs)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (OPTIONAL / PRIVILEGED OPERATIONS ONLY)
# Leave empty unless running isolated, trusted background workers or migrations.
# WARNING: Bypasses Row Level Security (RLS). Never expose to client code or API responses.
SUPABASE_SERVICE_ROLE_KEY=
